# Copy this file to .env.local and put your own connection string here.

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/myshop

# MongoDB Atlas (cloud) example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/myshop

# Used to sign the login session JWT (generate with: openssl rand -base64 32)
SESSION_SECRET=replace-with-a-long-random-secret
